{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudops-intelligence.example/schemas/ground-truth.schema.json",
  "title": "CloudOps Incident Ground Truth",
  "description": "Evaluation-only truth for one Incident Pack. This data must never be ingested as knowledge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "service",
    "environment",
    "incident_type",
    "occurred_at",
    "root_cause",
    "relevant_documents",
    "required_checks",
    "optional_checks",
    "unsafe_actions",
    "misleading_signals"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^INC-[0-9]{3}$"
    },
    "service": {
      "enum": [
        "checkout-api",
        "inventory-api",
        "notification-worker"
      ]
    },
    "environment": {
      "enum": [
        "production",
        "staging"
      ]
    },
    "incident_type": {
      "enum": [
        "ecs_deployment_misconfiguration",
        "rds_connection_pool_exhaustion",
        "downstream_service_timeout",
        "sqs_queue_backlog",
        "worker_out_of_memory"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "root_cause": {
      "$ref": "#/$defs/normalizedLabel"
    },
    "relevant_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "alarm.json",
          "deployment.json",
          "log-summary.txt",
          "postmortem.md",
          "related-runbook.md"
        ]
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/normalizedLabel"
      }
    },
    "optional_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/normalizedLabel"
      }
    },
    "unsafe_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/normalizedLabel"
      }
    },
    "misleading_signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/normalizedLabel"
      }
    }
  },
  "$defs": {
    "normalizedLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    }
  }
}
